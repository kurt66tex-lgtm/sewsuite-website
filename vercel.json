{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/|assets/|sew-suite-|robots.txt|sitemap.xml).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ],
      "missing": [
        {
          "type": "host",
          "value": "sewsuite.com"
        },
        {
          "type": "host",
          "value": "www.sewsuite.com"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/admin",
      "destination": "https://sewsuite-production-crm.vercel.app/admin",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "destination": "https://sewsuite-production-crm.vercel.app/admin/:path*",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "https://sewsuite-production-crm.vercel.app/login",
      "permanent": false
    },
    {
      "source": "/register",
      "destination": "https://sewsuite-production-crm.vercel.app/login",
      "permanent": false
    },
    {
      "source": "/forgot-password",
      "destination": "https://sewsuite-production-crm.vercel.app/login",
      "permanent": false
    },
    {
      "source": "/reset-password",
      "destination": "https://sewsuite-production-crm.vercel.app/login",
      "permanent": false
    }
  ]
}
